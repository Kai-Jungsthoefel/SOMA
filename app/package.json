{
  "name": "cadide-app",
  "version": "0.1.0",
  "private": true,
  "description": "CAD-IDE (Arbeitsname): Desktop-App fuer 3D-Modelle mit KI-Agenten",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "test:versions": "npm run build && node test/versions.mjs",
    "test:editor": "npm run build && node test/editor.mjs",
    "test:unit": "node test/unit.mjs",
    "test": "npm run build && node test/unit.mjs && node test/smoke.mjs && node test/versions.mjs && node test/editor.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dugite": "^3.2.3",
    "node-pty": "^1.1.0",
    "three": "^0.180.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
